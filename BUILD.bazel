# -*- Mode: python; -*-
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

# Our sources are C++20. This has to live on the targets, not in .bazelrc:
# a consumer that pulls this module in never reads our .bazelrc, so a project
# building everything else as C++17 would otherwise compile these sources with
# its own -std.
#
# The public header (include/aw-backtrace/aw-backtrace.h) is deliberately
# standard-agnostic -- it compiles as C99 and as C++11 and up -- so a consumer
# on an older standard can still include it.
CXXOPTS = [
    "-std=c++20",
    "-fno-exceptions",
    "-fno-rtti",
]

cc_library(
    name = "dwarf-constants",
    hdrs = ["dwarf-constants.h"],
)

cc_library(
    name = "eh-frame-reader",
    hdrs = ["eh-frame-reader.h"],
    deps = [
        ":aw-base",
        ":check",
        ":dwarf-constants",
        ":with-exit",
    ],
)

cc_test(
    name = "eh-frame-reader-test",
    srcs = ["eh-frame-reader-test.cc"],
    cxxopts = CXXOPTS,
    deps = [
        ":eh-frame-reader",
        ":with-exit",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "aw-backtrace-skip-test",
    srcs = ["aw-backtrace-skip-test.cc"],
    cxxopts = CXXOPTS,
    features = ["-supports_start_end_lib"],
    deps = [
        ":aw-backtrace",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "check",
    hdrs = ["check.h"],
)

cc_library(
    name = "aw-base",
    hdrs = [
        "aw-arch.h",
        "aw-arch-aarch64.h",
        "aw-arch-x86_64.h",
        "aw-structs.h",
        "simple-counter.h",
        "unwind-info-cache.h",
        "utils.h",
    ],
    # For UnwindInfoCache's 128-bit atomics: gcc emits __atomic_*_16 calls
    linkopts = ["-latomic"],
    deps = [
        ":aw-addrcheck",
        ":dwarf-constants",
    ],
)

cc_library(
    name = "function_ref",
    hdrs = ["function_ref.h"],
)

cc_library(
    name = "static_storage",
    hdrs = ["static_storage.h"],
)

cc_library(
    name = "with-exit",
    srcs = [
        "with-exit-amd64.S",
        "with-exit-generic.cc",
    ],
    hdrs = ["with-exit.h"],
    cxxopts = CXXOPTS,
    deps = [":function_ref"],
)

# Same sources, but forced onto the setjmp/longjmp fallback, so the
# portable path stays exercised on machines that have real asm for it.
cc_library(
    name = "with-exit-forced-generic",
    srcs = [
        "with-exit-generic.cc",
    ],
    hdrs = ["with-exit.h"],
    cxxopts = CXXOPTS,
    defines = ["FORCED_WITH_EXIT_GENERIC"],
    deps = [":function_ref"],
)

cc_test(
    name = "with-exit-test",
    srcs = ["with-exit-test.cc"],
    cxxopts = CXXOPTS,
    deps = [
        ":check",
        ":with-exit",
    ],
)

cc_test(
    name = "with-exit-generic-test",
    srcs = ["with-exit-test.cc"],
    cxxopts = CXXOPTS,
    deps = [
        ":check",
        ":with-exit-forced-generic",
    ],
)

cc_library(
    name = "aw-backtrace",
    srcs = [
        "aw-backtrace.cc",
        "aw-backtrace-fastpath.h",
        "backtrace-core.cc",
        "backtrace-core.h",
        "backtrace-drap.h",
    ],
    hdrs = [
        "include/aw-backtrace/aw-backtrace.h",
    ],
    cxxopts = CXXOPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":aw-addrcheck",
        ":aw-base",
        ":check",
        ":dwarf-constants",
        ":eh-frame-reader",
        ":function_ref",
        ":static_storage",
        ":with-exit",
    ],
)

# Kludge for the perf-convert reaching into aw-backtrace but only for
# the header (really fastpath stuff below).
cc_library(
    name = "aw-backtrace-hdr",
    hdrs = ["include/aw-backtrace/aw-backtrace.h"],
    strip_include_prefix = "include",
)

cc_library(
    name = "aw-fastpath",
    hdrs = [
        "aw-backtrace-fastpath.h",
        "backtrace-core.h",
    ],
    visibility = ["//perf-convert:__pkg__"],
    deps = [
        ":aw-backtrace-hdr",
        ":aw-base",
        ":check",
        ":dwarf-constants",
        ":eh-frame-reader",
        ":function_ref",
        ":with-exit",
    ],
)

# We need to copy the binary to a known location so we can include it
# and crucially, we need it to be in the same package (genfiles root)
# Convert binary to object file using objcopy
# We copy it to a simple name first so objcopy generates predictable symbol names
genrule(
    name = "sym_helper_obj",
    srcs = [":sym-helper"],
    outs = ["sym_helper.o"],
    cmd = "cp $(location :sym-helper) $(@D)/sym_helper_bin && " +
          "cd $(@D) && objcopy -I binary -O " +
          select({
              "@platforms//cpu:aarch64": "elf64-littleaarch64",
              "//conditions:default": "elf64-x86-64",
          }) + " sym_helper_bin `basename $@` --rename-section .data=.rodata,alloc,load,readonly,data,contents",
)

cc_library(
    name = "symbolize-backtrace",
    srcs = [
        "sym_helper.o",
        "symbolize-backtrace.cc",
    ],
    hdrs = ["symbolize-backtrace.h"],
    cxxopts = CXXOPTS,
    deps = [
        ":check",
        ":function_ref",
    ],
)

cc_library(
    name = "backtrace-comparer",
    srcs = select({
        "@platforms//cpu:x86_64": ["backtrace-comparer.cc"],
        "//conditions:default": [],
    }),
    hdrs = ["backtrace-comparer.h"],
    cxxopts = CXXOPTS,
    deps = select({
        "@platforms//cpu:x86_64": [
            ":aw-backtrace",
            ":symbolize-backtrace",
            "@mini-x86-int//:sim_stepper",
        ],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "simple-fp-backtrace",
    srcs = ["simple-fp-backtrace.cc"],
    hdrs = ["simple-fp-backtrace.h"],
    cxxopts = CXXOPTS,
    deps = [":aw-base"],
)

cc_test(
    name = "aw-backtrace-test",
    srcs = [
        "aw-backtrace-test.cc",
    ] + select({
        "@platforms//cpu:x86_64": [
            "amd64-drap-test.s",
        ],
        "//conditions:default": [],
    }),
    cxxopts = CXXOPTS,
    # needed to prevent GNU ld crashes
    features = ["-supports_start_end_lib"],
    linkstatic = True,
    deps = [
        ":aw-backtrace",
        ":backtrace-comparer",
        ":check",
        ":symbolize-backtrace",
    ] + select({
        "@platforms//cpu:x86_64": ["@mini-x86-int//:sim_stepper"],
        "//conditions:default": [],
    }),
)

cc_test(
    name = "simple-backtrace-test",
    srcs = [
        "aw-backtrace-test.cc",
    ],
    cxxopts = CXXOPTS,
    defines = ["BT_USE_SIMPLE=1"],
    linkstatic = True,
    deps = [
        ":check",
        ":simple-fp-backtrace",
        ":symbolize-backtrace",
    ],
)

cc_test(
    name = "symbolize-backtrace-test",
    srcs = ["symbolize-backtrace-test.cc"],
    cxxopts = CXXOPTS,
    linkstatic = True,
    deps = [
        ":function_ref",
        ":symbolize-backtrace",
    ],
)

cc_binary(
    name = "recursion-test",
    srcs = ["recursion-test.cc"],
    cxxopts = CXXOPTS,
    defines = ["USE_AW_BACKTRACE"],
    features = ["-supports_start_end_lib"],
    deps = [":aw-backtrace"],
)

cc_binary(
    name = "recursion-test-libgcc",
    srcs = ["recursion-test.cc"],
    cxxopts = CXXOPTS,
    defines = ["USE_LIBGCC_BACKTRACE"],
)

cc_binary(
    name = "recursion-test-fp",
    srcs = ["recursion-test.cc"],
    copts = ["-fno-omit-frame-pointer"],
    cxxopts = CXXOPTS,
    defines = ["USE_FP_BACKTRACE"],
    deps = [":simple-fp-backtrace"],
)

cc_binary(
    name = "sym-helper",
    srcs = ["sym-helper.cc"],
    cxxopts = CXXOPTS,
)

cc_library(
    name = "aw-addrcheck",
    srcs = ["aw-addrcheck.c"],
    hdrs = ["aw-addrcheck.h"],
)

cc_binary(
    name = "bench-addrcheck",
    srcs = ["bench-addrcheck.c"],
    deps = [":aw-addrcheck"],
)

cc_test(
    name = "aw-addrcheck-test",
    srcs = ["aw-addrcheck-test.c"],
    deps = [":aw-addrcheck"],
)

cc_test(
    name = "lua-test",
    srcs = ["lua-test.cc"],
    cxxopts = CXXOPTS,
    features = ["-supports_start_end_lib"],
    linkstatic = True,
    deps = [
        ":aw-backtrace",
        ":backtrace-comparer",
        "@lua",
    ],
)

cc_test(
    name = "amd64-leaf-test",
    srcs = [
        "amd64-leaf-test.cc",
    ],
    cxxopts = CXXOPTS,
    features = ["-supports_start_end_lib"],
    linkstatic = True,
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        ":aw-backtrace",
        ":check",
        ":symbolize-backtrace",
    ],
)
