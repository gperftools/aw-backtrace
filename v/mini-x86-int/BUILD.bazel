# Folded into aw-backtrace as a plain package; edit directly (the generator
# script that once produced this no longer travels with the code).
# linux/x86-64 only, like the differential-testing apparatus it serves.

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

DEFAULT_COPTS = []  #["-std=c++20 -fsized-deallocation"]

LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

cc_library(
    name = "mini-x86-int",
    srcs = [
        "mini-x86-int.cc",
        "mini-x86-int.h",
        "performs.S",
    ],
    copts = DEFAULT_COPTS,
    includes = ["."],
    target_compatible_with = LINUX_X86_64,
)

cc_library(
    name = "single_stepper",
    srcs = [
        "base/cleanup.h",
        "base/single_stepper.cc",
        "base/static_storage.h",
    ],
    hdrs = ["base/single_stepper.h"],
    copts = DEFAULT_COPTS,
    includes = ["."],
    target_compatible_with = LINUX_X86_64,
)

cc_library(
    name = "sim_stepper",
    srcs = ["sim_stepper.cc"],
    hdrs = ["sim_stepper.h"],
    copts = DEFAULT_COPTS,
    includes = ["."],
    target_compatible_with = LINUX_X86_64,
    deps = [
        ":mini-x86-int",
        ":single_stepper",
    ],
)

cc_test(
    name = "mini-x86-int_test",
    srcs = [
        "mini-x86-int_test.cc",
        "test-cases.S",
    ],
    copts = DEFAULT_COPTS,
    linkstatic = True,
    target_compatible_with = LINUX_X86_64,
    deps = [":mini-x86-int"],
)

cc_test(
    name = "sim_stepper_test",
    srcs = ["sim_stepper_test.cc"],
    copts = DEFAULT_COPTS,
    # needed to prevent GNU ld crashes
    features = ["-supports_start_end_lib"],
    linkstatic = True,
    target_compatible_with = LINUX_X86_64,
    deps = [
        ":mini-x86-int",
        ":sim_stepper",
        ":single_stepper",
    ],
)

cc_test(
    name = "test-signal-disable",
    srcs = ["test-signal-disable.cc"],
    copts = DEFAULT_COPTS,
    linkstatic = True,
    target_compatible_with = LINUX_X86_64,
    deps = [":sim_stepper"],
)
